    <string>io.github.codemee.feditor</string>
    <key>CFBundleExecutable</key>
    <string>feditor</string>
    <key>CFBundleIconFile</key>
    <string>FEditor</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
